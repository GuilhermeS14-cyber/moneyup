NODE_ENV=development
PORT=4173
# A URL abaixo é usada para um servidor PostgreSQL convencional.
# npm start:dev inicia PGlite local e injeta DATABASE_URL automaticamente.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable
SESSION_SECRET=preencha-com-um-segredo-aleatorio-de-pelo-menos-32-caracteres
CSRF_SECRET=preencha-com-outro-segredo-aleatorio-de-pelo-menos-32-caracteres
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
POSTGRES_PASSWORD=use-uma-senha-aleatoria-para-o-compose
DATABASE_SSL=false
